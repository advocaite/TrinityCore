# Copy to .env and fill in. Never commit .env.

# MySQL passwords: letters and digits only (no ';'), e.g. the output of: openssl rand -hex 16
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# IPv4 address players connect to: 127.0.0.1 (this machine only), or the server's address on your network (LAN IP,
# VPN address, public IP).
PUBLIC_IP=127.0.0.1

# Where ports 1119, 8081 and 8085 are published: 127.0.0.1 (this machine only), one address of this machine (for
# example a VPN address), or 0.0.0.0 (every network; then limit who can connect with a firewall).
PUBLISH_IP=127.0.0.1

# The World of Warcraft folder of the 1.60.1.70450 client (the one that holds .build.info and _classic_beta_). Only the
# extractor reads it.
WOW_DIR=./wow

# Where the extracted game data (dbc, gt, maps, vmaps) is kept.
DATA_DIR=./data

# 1 builds the spell test module into the image (doc/Docker.md); rebuild with: docker compose build worldserver
BUILD_SPELL_TEST=0
